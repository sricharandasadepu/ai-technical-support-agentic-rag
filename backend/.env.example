# Copy to backend/.env only if you do not already have one. Never commit secrets.
APP_NAME=AI Technical Support Resolution Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
AZURE_STORAGE_CONNECTION_STRING=replace-with-your-existing-connection-string
AZURE_STORAGE_CONTAINER_NAME=replace-with-your-container
PINECONE_API_KEY=replace-with-your-existing-key
PINECONE_INDEX_NAME=replace-with-your-existing-384-dimension-index
GROQ_API_KEY=replace-with-your-existing-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional settings; paths are relative to backend/ unless absolute.
GROQ_TIMEOUT_SECONDS=30
RAG_CORPUS_PATH=notebooks/retrieval_evaluation_data.json
RAG_RETRIEVAL_K=10
RAG_CANDIDATE_K=10
RAG_FINAL_K=5
RAG_INITIALIZATION_RETRY_SECONDS=60
CONVERSATION_HISTORY_TURNS=3
