# Public browser configuration only. Never copy backend secrets into VITE_* variables.
# /api uses Vite's dev proxy and a same-origin reverse proxy in production.
VITE_API_BASE_URL=/api
# Normal HTTP response timeout for chat, including first-use model initialization.
VITE_CHAT_TIMEOUT_MS=300000
# Development proxy destination; this variable is server-side, not included in the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
